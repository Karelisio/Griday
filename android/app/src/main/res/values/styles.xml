<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème de l'application (composants hors activité) : sans barre d'action, clair/sombre. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
        Thème de l'activité une fois démarrée (BridgeActivity l'applique lui-même). Edge-to-edge :
        barres système transparentes. Les attributs plus récents que minSdk sont ajoutés par
        values-v27 et values-v29, qui redéfinissent AppTheme.NoActionBar au-dessus de cette base.
    -->
    <style name="Base.AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:background">@null</item>
        <!-- Couleur unie, pas un drawable : le plugin SystemBars relit cet attribut pour peindre le fond. -->
        <item name="android:windowBackground">@color/griday_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/griday_navigation_bar</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Base.AppTheme.NoActionBar" />

    <!--
        Écran de démarrage (androidx core-splashscreen) : fond de la marque et icône de l'app.
        Android 12+ : splash système ; avant : fenêtre de lancement unie. Même découpage par version.
    -->
    <style name="Base.AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/griday_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Icônes claires des barres système sur le fond violet. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Base.AppTheme.NoActionBarLaunch" />
</resources>
