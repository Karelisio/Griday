<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- enableOnBackInvokedCallback : retour prédictif (animation système du geste « retour »). -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Portrait uniquement. Thème de lancement = écran de démarrage ; BridgeActivity applique ensuite AppTheme.NoActionBar. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Identifiant d'application AdMob (obligatoire dès que le SDK est présent, sinon plantage au démarrage).
            Fourni par Gradle : variable d'environnement ADMOB_APP_ID, sinon identifiant de test de Google.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Rappel quotidien : Android 13+ demande l'autorisation à l'activation du rappel (déjà déclarée par le plugin). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Alarmes exactes : Google Play les réserve aux applications de réveil et d'agenda. Les rappels n'ont pas besoin
        de la minute exacte : on retire la permission que le plugin ajoute, ils sont programmés en alarmes inexactes
        (isExactNotification: false, voir src/platform/notifications.ts).
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
</manifest>
