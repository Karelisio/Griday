# Variables de build (copier en .env.local, jamais versionné). Toutes facultatives.
# Sans identifiants réels, et toujours en développement : annonces de TEST de Google.

# false : APK personnel sans publicité ni achat, tout débloqué (cap sync exclut aussi les plugins de monétisation).
# VITE_ADS=false

# Blocs d'annonces AdMob réels (build web) :
# VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
# VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN

# Produit Premium de la Play Console (défaut : griday_premium) :
# VITE_PREMIUM_PRODUCT_ID=griday_premium

# Identifiant d'application AdMob, lu par Gradle (variable d'environnement, pas par Vite) :
# ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN
